using UnityEngine;

public class CameraFollow : MonoBehaviour
{
    public Transform target;
    public float speed = 5f;

    void LateUpdate()
    {
        Vector3 targetPos = new Vector3(
            target.position.x,
            target.position.y,
            -10f
        );

        transform.position = Vector3.Lerp(
            transform.position,
            targetPos,
            speed * Time.deltaTime
        );
    }
}
