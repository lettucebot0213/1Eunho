using UnityEngine;

public class playermove : MonoBehaviour
{
    public Gamemanager manager; // 대화창 및 게임 상태를 관리하는 게임매니저

    GameObject scanObject; // 플레이어가 바라보고 있는 오브젝트
    Vector3 dirVec; // 플레이어가 바라보는 방향
    Animator anim; // 애니메이터 컴포넌트
    public float Speed = 5f; // 플레이어 이동 속도

    float h; // 좌우 입력값
    float v; // 상하 입력값

    bool isHorizonMove = true; // 마지막 이동 방향이 가로인지 확인

    Rigidbody2D rigid; // Rigidbody2D 컴포넌트

    void Start() // 게임 시작 시 한 번 실행
    {
        rigid = GetComponent<Rigidbody2D>(); // Rigidbody2D 가져오기
        anim = GetComponent<Animator>(); // Animator 가져오기
    }

    void Update() // 매 프레임마다 실행
    {
        if (manager.isAction) // 대화 중일 경우
        {
            h = 0;
            v = 0; // 이동 입력 제거

            if (Input.GetButtonDown("Jump")) // 스페이스바 입력 시
            {
                manager.Action(null); // 대화 종료
            }
            return;
        }

        h = Input.GetAxisRaw("Horizontal"); // 좌우 입력 받기
        v = Input.GetAxisRaw("Vertical"); // 상하 입력 받기

        bool hDown = Input.GetButtonDown("Horizontal"); // 좌우키 눌림 감지
        bool vDown = Input.GetButtonDown("Vertical"); // 상하키 눌림 감지
        bool hUp = Input.GetButtonUp("Horizontal"); // 좌우키 뗌 감지
        bool vUp = Input.GetButtonUp("Vertical"); // 상하키 뗌 감지

        if(hDown || vUp)
            isHorizonMove = true; // 가로 이동 상태
        else if(vDown || hUp)
            isHorizonMove = false; // 세로 이동 상태

        // 애니메이터 파라미터 변경
        if (anim.GetInteger("hAxisRaw") != (int)h)
        {
            anim.SetBool("isChange", true);
            anim.SetInteger("hAxisRaw",(int)h);
        }
        else if (anim.GetInteger("vAxisRaw") != v)
        {
            anim.SetBool("isChange",true);
            anim.SetInteger("vAxisRaw",(int)v);
        }
        else
            anim.SetBool("isChange",false);

        // 플레이어가 바라보는 방향 저장
        if(vDown && v == 1)
            dirVec = Vector3.up;
        else if(vDown && v == -1)
            dirVec = Vector3.down;
        else if(hDown && h == -1)
            dirVec = Vector3.left;
        else if(hDown && h == 1)
            dirVec = Vector3.right;

        // 상호작용 키 입력 시
        if(Input.GetButtonDown("Jump") && scanObject != null)
        {
            Debug.Log("this is" + scanObject.name); // 확인용 로그 출력
            manager.Action(scanObject); // 오브젝트와 상호작용
        }
    }

    void FixedUpdate() // 물리 연산 처리
    {
        if (manager.isAction) // 대화 중일 경우
        {
            rigid.linearVelocity = Vector2.zero; // 이동 정지
            return;
        }

        // 가로 또는 세로 방향으로 이동
        Vector2 moveVec = isHorizonMove ? new Vector2(h,0) : new Vector2(0,v);

        rigid.linearVelocity = moveVec * Speed; // 실제 이동 적용

        // 플레이어 앞 방향으로 레이 표시
        Debug.DrawRay(rigid.position, dirVec * 0.7f , new Color(0,1,0));

        // 플레이어 앞 오브젝트 탐색
        RaycastHit2D rayhit = Physics2D.Raycast(
            rigid.position,
            dirVec,
            0.7f,
            LayerMask.GetMask("object")
        );

        if(rayhit.collider != null)
        {
            scanObject = rayhit.collider.gameObject; // 오브젝트 발견
        }
        else
            scanObject = null; // 아무것도 없으면 초기화
    }
}            // 스페이스바를 누르면 대화 종료
            if (Input.GetButtonDown("Jump"))
            {
                manager.Action(null);
            }
            return;
        }

        // 방향키 또는 WASD 입력값 가져오기
        h = Input.GetAxisRaw("Horizontal");
        v = Input.GetAxisRaw("Vertical");

        // 키를 눌렀는지 확인
        bool hDown = Input.GetButtonDown("Horizontal");
        bool vDown = Input.GetButtonDown("Vertical");
        bool hUp = Input.GetButtonUp("Horizontal");
        bool vUp = Input.GetButtonUp("Vertical");

        // 가로키를 눌렀거나 세로키를 뗐다면
        // 가로 이동 모드
        if(hDown || vUp)
            isHorizonMove = true;

        // 세로키를 눌렀거나 가로키를 뗐다면
        // 세로 이동 모드
        else if(vDown || hUp)
            isHorizonMove = false;

        // 좌우 방향 애니메이션 변경
        if (anim.GetInteger("hAxisRaw") != (int)h)
        {
            anim.SetBool("isChange", true); // 방향이 바뀌었다고 알림
            anim.SetInteger("hAxisRaw",(int)h); // 새로운 방향 저장
        }

        // 상하 방향 애니메이션 변경
        else if (anim.GetInteger("vAxisRaw") != v)
        {
            anim.SetBool("isChange",true);
            anim.SetInteger("vAxisRaw",(int)v);
        }

        // 방향이 바뀌지 않았다면
        else
            anim.SetBool("isChange",false);

        // 플레이어가 바라보는 방향 저장
        if(vDown && v == 1)
            dirVec = Vector3.up; // 위

        else if(vDown && v == -1)
            dirVec = Vector3.down; // 아래

        else if(hDown && h == -1)
            dirVec = Vector3.left; // 왼쪽

        else if(hDown && h == 1)
            dirVec = Vector3.right; // 오른쪽

        // 스페이스바를 눌렀고
        // 앞에 상호작용 가능한 오브젝트가 있다면
        if(Input.GetButtonDown("Jump") && scanObject != null)
        {
            // 콘솔창에 오브젝트 이름 출력
            Debug.Log("this is " + scanObject.name);

            // 대화창 열기
            manager.Action(scanObject);
        }
    }

    void FixedUpdate() // 물리 연산용 함수
    {
        // 대화중이면 이동 금지
        if (manager.isAction)
        {
            rigid.linearVelocity = Vector2.zero;
            return;
        }

        // 가로 이동이면 (x,0)
        // 세로 이동이면 (0,y)
        Vector2 moveVec = isHorizonMove ?
                          new Vector2(h,0) :
                          new Vector2(0,v);

        // 이동속도 적용
        rigid.linearVelocity = moveVec * Speed;

        // Scene 창에서 레이 확인용 초록선
        Debug.DrawRay(
            rigid.position,
            dirVec * 0.7f,
            new Color(0,1,0)
        );

        // 플레이어가 바라보는 방향으로 레이 발사
        RaycastHit2D rayhit = Physics2D.Raycast(
            rigid.position,              // 시작 위치
            dirVec,                      // 방향
            0.7f,                        // 거리
            LayerMask.GetMask("object")  // object 레이어만 감지
        );

        // 오브젝트가 감지되었다면
        if(rayhit.collider != null)
        {
            scanObject = rayhit.collider.gameObject;
        }
        // 아무것도 없다면
        else
        {
            scanObject = null;
        }
    }
}
